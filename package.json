{
  "name": "event-paynow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc -p web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "wrangler dev",
    "web:dev": "cd web && wrangler pages dev public --d1 paynow_db",
    "web:deploy": "cd web && wrangler pages deploy public --project-name event-paynow-web",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply paynow-db --local",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.30.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "jsqr": "^1.4.0",
    "playwright": "^1.65.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "esbuild": ">=0.25.12"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261104.1": true,
    "better-sqlite3@13.0.3": true,
    "sharp@0.33.5": true
  }
}
